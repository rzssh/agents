#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
package_file="$root/pkgs/pi-coding-agent/package.nix"
npm_lock="$root/pkgs/pi-coding-agent/package-lock.json"
flake_file="$root/flake.nix"
lock_file="$root/flake.lock"
package="@earendil-works/pi-coding-agent"
current="$(sed -n 's/^  version = "\([^"]*\)";$/\1/p' "$package_file")"
latest="$(npm view "$package@latest" version)"

if [[ -z "$current" || ! "$latest" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
	printf 'update-pi: could not resolve current or latest version\n' >&2
	exit 1
fi

if [[ "$current" == "$latest" ]]; then
	printf 'Pi already current: %s\n' "$current"
	exit 0
fi

backup="$(mktemp -d)"
cp "$flake_file" "$lock_file" "$package_file" "$npm_lock" "$backup/"
complete=0

cleanup() {
	if [[ "$complete" -eq 0 ]]; then
		cp "$backup/flake.nix" "$flake_file"
		cp "$backup/flake.lock" "$lock_file"
		cp "$backup/package.nix" "$package_file"
		cp "$backup/package-lock.json" "$npm_lock"
	fi
	rm -rf -- "$backup"
}
trap cleanup EXIT

OLD_VERSION="$current" NEW_VERSION="$latest" perl -0pi -e '
	my $count = s{(pi-coding-agent-|^  version = ")\Q$ENV{"OLD_VERSION"}\E}{$1 . $ENV{"NEW_VERSION"}}gme;
	die "Pi version not found\n" unless $count == 1;
' "$flake_file" "$package_file"

cd "$root"
nix flake update pi-coding-agent-src
source="$(nix eval --raw .#packages.x86_64-linux.pi-coding-agent.src)"
mkdir "$backup/npm"
node -e '
	const fs = require("node:fs");
	const pkg = JSON.parse(fs.readFileSync(process.argv[1]));
	delete pkg.devDependencies;
	fs.writeFileSync(process.argv[2], JSON.stringify(pkg, null, 2));
' "$source/package.json" "$backup/npm/package.json"
(cd "$backup/npm" && npm install --package-lock-only --ignore-scripts --no-audit --no-fund --cache "$backup/npm-cache")
cp "$backup/npm/package-lock.json" "$npm_lock"

npm_hash="$(NPM_FETCHER_VERSION=2 prefetch-npm-deps "$npm_lock")"
if [[ ! "$npm_hash" =~ ^sha256-[A-Za-z0-9+/]{43}=$ ]]; then
	printf 'update-pi: invalid npm dependency hash\n' >&2
	exit 1
fi

NPM_DEPS_HASH="$npm_hash" perl -0pi -e '
	my $count = s{npmDepsHash = (?:"[^"]+"|lib\.fakeHash);}{npmDepsHash = "$ENV{NPM_DEPS_HASH}";};
	die "npmDepsHash not found\n" unless $count == 1;
' "$package_file"

complete=1
printf 'Updated Pi %s -> %s. Build and activate separately.\n' "$current" "$latest"
